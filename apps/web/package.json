{
  "name": "@nitap/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "check-types": "next typegen && tsc --noEmit",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "arch": "depcruise src tests --config ../../.dependency-cruiser.cjs --ts-config tsconfig.json",
    "test": "vitest run --project unit --project dom",
    "test:integration": "vitest run --project integration --project contract",
    "test:watch": "vitest --project unit --project dom",
    "test:coverage": "vitest run --project unit --project dom --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:seed:admin": "node --experimental-strip-types --env-file-if-exists=../../.env scripts/seed-dev-admin.ts",
    "admin:bootstrap": "node --experimental-strip-types --env-file-if-exists=../../.env scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.5",
    "@hookform/resolvers": "^5.9.1",
    "@next/env": "16.3.5",
    "@nitap/database": "workspace:*",
    "@nitap/jobs": "workspace:*",
    "@nitap/observability": "workspace:*",
    "@nitap/queue": "workspace:*",
    "@nitap/search": "workspace:*",
    "@nitap/storage": "workspace:*",
    "@nitap/ui": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-devtools": "^5.103.1",
    "better-auth": "1.7.5",
    "ioredis": "6.0.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "react-hook-form": "^7.88.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nitap/eslint-config": "workspace:*",
    "@nitap/testing": "workspace:*",
    "@nitap/typescript-config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.0",
    "pg": "^8.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1"
  }
}
