{
  "extends": "@nitap/typescript-config/nextjs.json",
  "compilerOptions": {
    // @nitap/database is run by Node's native type stripping, which needs explicit `.ts` import
    // extensions; tsc only allows them when nothing is emitted (noEmit is on in the base config).
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
