                "message": "Prisma, Redis, queues and provider SDKs belong to infrastructure/."
              },
              {
                "group": ["better-auth", "better-auth/**"],
                "message": "Better Auth is wired only in infrastructure/ (the createAuth factory) and app/ (its route handler); the domain and use cases stay library-free."
              },
              {
                "group": ["react", "react/**", "react-dom", "react-dom/**"],
                "message": "React is a presentation/ui concern."
              },
              {
                "group": ["next", "next/**"],
                "message": "Next.js belongs to app/, presentation/ui and proxy.ts."
              },
              {
                "group": ["@nitap/ui", "@nitap/ui/**"],
                "message": "@nitap/ui is for app/ and presentation/ui only."
              },
              {
                "group": ["@/components/**"],
                "message": "App-level UI is not visible to the layers below it."
              },
              {
                "group": ["@/modules/**", "@/modules/*/**"],
                "message": "This layer may not import another module. Coordinate through the application layer or events."
              },
              {
                "group": ["**/infrastructure", "**/infrastructure/**"],
                "message": "Nothing inward imports infrastructure; depend on an interface the layer declares."
              },
              {
                "group": ["**/application/**"],
                "message": "domain and infrastructure may not depend on use cases."
              },
              {
                "group": ["**/presentation/**"],
                "message": "Dependencies point inward: nothing imports presentation."
              }
            ],
            "paths": [
              {
                "name": "@nitap/database",
                "message": "Prisma, Redis, queues and provider SDKs belong to infrastructure/."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "window",
            "message": "The domain is pure: no browser APIs."
          },
          {
            "name": "document",
            "message": "The domain is pure: no browser APIs."
          },
          {
            "name": "localStorage",
            "message": "The domain is pure: no browser APIs."
          },
          {
            "name": "sessionStorage",
            "message": "The domain is pure: no browser APIs."
          },
          {
            "name": "navigator",
            "message": "The domain is pure: no browser APIs."
          }
        ]
      }
