{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": [
    "CI",
    "COVERAGE_SHARD",
    "DATABASE_URL",
    "MIGRATE_DATABASE_URL",
    "SHADOW_DATABASE_URL",
    "REDIS_URL",
    "QUEUE_REDIS_URL",
    "SMTP_URL",
    "EMAIL_FROM",
    "EMAIL_RATE_PER_SECOND",
    "WORKER_HEALTH_PORT",
    "MAILPIT_UI_PORT",
    "MAILPIT_URL",
    "INSTITUTIONAL_EMAIL_POLICY",
    "E2E_INSTITUTIONAL_DOMAIN",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "APP_URL",
    "HEALTH_CHECK_TOKEN",
    "LOG_LEVEL",
    "APP_VERSION",
    "SENTRY_DSN",
    "PLAYWRIGHT_TEST_BASE_URL",
    "NODE_ENV",
    "NEXT_RUNTIME",
    "DEV_ADMIN_EMAIL",
    "DEV_ADMIN_PASSWORD",
    "DEV_COORDINATOR_EMAIL",
    "DEV_COORDINATOR_PASSWORD",
    "DEV_ROLES_PASSWORD",
    "BOOTSTRAP_ADMIN_EMAIL",
    "BOOTSTRAP_ADMIN_PASSWORD",
    "E2E_STAFF_DOMAIN",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_FORCE_PATH_STYLE",
    "S3_PUBLIC_PATH",
    "PERF_DATABASE_URL",
    "DATABASE_POOL_MAX",
    "PERF_PASSWORD",
    "CLAMAV_URL",
    "DRILL_HOST",
    "PORT"
  ],
  "tasks": {
    "transit": { "dependsOn": ["^transit"] },
    "db:seed": { "cache": false },
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "env": ["NEXT_PUBLIC_*", "NEXT_OUTPUT", "NEXT_DEPLOYMENT_ID"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": { "dependsOn": ["transit"] },
    "lint:fix": { "dependsOn": ["transit"], "cache": false },
    "arch": { "dependsOn": ["transit"] },
    "typecheck": { "dependsOn": ["transit", "^db:generate"] },
    "test": { "dependsOn": ["transit", "^db:generate"] },
    "test:coverage": {
      "dependsOn": ["transit", "^db:generate"],
      "env": ["EVENT_RACE_ITERATIONS", "SYSTEM_RACE_ITERATIONS", "FUZZ_RUNS"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "test:watch": { "cache": false, "persistent": true },
    "test:integration": {
      "dependsOn": ["transit", "^db:generate"],
      "env": ["EVENT_RACE_ITERATIONS", "SYSTEM_RACE_ITERATIONS", "FUZZ_RUNS"],
      "cache": false
    },
    "test:e2e": { "dependsOn": ["transit", "^db:generate"], "cache": false },
    "test:e2e:ui": { "cache": false, "persistent": true },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "start": { "dependsOn": ["build"], "cache": false, "persistent": true },
    "check-types": { "dependsOn": ["transit", "^db:generate"] }
  }
}
