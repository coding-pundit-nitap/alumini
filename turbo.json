{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": [
    "CI",
    "DATABASE_URL",
    "MIGRATE_DATABASE_URL",
    "REDIS_URL",
    "QUEUE_REDIS_URL",
    "SMTP_URL",
    "EMAIL_FROM",
    "EMAIL_RATE_PER_SECOND",
    "WORKER_HEALTH_PORT",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "HEALTH_CHECK_TOKEN",
    "LOG_LEVEL",
    "APP_VERSION",
    "PLAYWRIGHT_TEST_BASE_URL"
  ],
  "tasks": {
    "transit": { "dependsOn": ["^transit"] },
    "db:seed": { "cache": false },
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "env": ["NEXT_PUBLIC_*"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": { "dependsOn": ["transit"] },
    "lint:fix": { "dependsOn": ["transit"], "cache": false },
    "arch": { "dependsOn": ["transit"] },
    "typecheck": { "dependsOn": ["transit", "^db:generate"] },
    "test": { "dependsOn": ["transit", "^db:generate"] },
    "test:coverage": {
      "dependsOn": ["transit", "^db:generate"],
      "outputs": ["coverage/**"]
    },
    "test:watch": { "cache": false, "persistent": true },
    "test:integration": {
      "dependsOn": ["transit", "^db:generate"],
      "cache": false
    },
    "test:e2e": { "dependsOn": ["transit", "^db:generate"], "cache": false },
    "test:e2e:ui": { "cache": false, "persistent": true },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "start": { "dependsOn": ["build"], "cache": false, "persistent": true }
  }
}
