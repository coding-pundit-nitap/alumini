# Environment Variables Template
# One .env at the repository root serves the whole workspace: Next.js loads it via apps/web/next.config.ts,
# Prisma via database/prisma.config.ts, and `pnpm docker:up` passes it to docker compose.
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (see docker-compose.yml). Used by the app and by the Prisma CLI (prisma.config.ts).
# If port 5432 is taken, run `POSTGRES_PORT=5433 docker compose up -d` and change the port below.
DATABASE_URL=postgresql://alumini:alumini@localhost:5432/alumini

# Better Auth. Generate the secret with: openssl rand -base64 32  (>= 32 chars, different per environment)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Redis (cache and rate limiting; see docker-compose.yml). If 6379 is taken: `REDIS_PORT=6380 docker compose up -d`.
REDIS_URL=redis://localhost:6379
