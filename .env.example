# Environment Variables Template
# One .env at the repository root serves the whole workspace: Next.js loads it via apps/web/next.config.ts,
# Prisma via packages/database/prisma.config.ts, and `pnpm docker:up` passes it to docker compose.
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (see docker-compose.yml). Used by the app and by the Prisma CLI (prisma.config.ts).
# If port 5432 is taken, run `POSTGRES_PORT=5433 docker compose up -d` and change the port below.
DATABASE_URL=postgresql://alumini:alumini@localhost:5432/alumini
# Optional. `pnpm db:drift` replays the migrations into <db>_shadow next to DATABASE_URL (created when
# missing, wiped on every run); set this to use another database instead.
# SHADOW_DATABASE_URL=postgresql://alumini:alumini@localhost:5432/alumini_shadow
# Connections per web instance (default 10). Sized from the load tests; instances × this, plus the
# worker's pool, must stay under PostgreSQL's max_connections.
# DATABASE_POOL_MAX=10

# Better Auth. Generate the secret with: openssl rand -base64 32  (>= 32 chars, different per environment)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Redis (cache and rate limiting; see docker-compose.yml). If 6379 is taken: `REDIS_PORT=6380 docker compose up -d`.
REDIS_URL=redis://localhost:6379

# Logging (optional). debug | info | warn | error | fatal | silent. Defaults to info (silent under test).
# LOG_LEVEL=info
# Build/commit id stamped on every log line; set by the deploy pipeline.
# APP_VERSION=dev
# Error tracker DSN (Sentry or GlitchTip), used by web and worker. Unset = tracker off.
# SENTRY_DSN=
# clamd for upload malware scanning (`pnpm docker:scan`). Required in production; unset = uploads unscanned.
# CLAMAV_URL=tcp://localhost:3310

# Dev-only super admin seeded by `pnpm db:seed` (skipped when NODE_ENV=production or unset here).
# Never set these in a shared or production environment.
# DEV_ADMIN_EMAIL=admin@example.com
# DEV_ADMIN_PASSWORD=change-me-locally-1234

# Job queue Redis: a SEPARATE instance from REDIS_URL, noeviction + AOF. If 6380 is taken: `QUEUE_REDIS_PORT=6381 pnpm docker:up`.
QUEUE_REDIS_URL=redis://localhost:6380

# Public web origin used by the worker for links in notification emails.
APP_URL=http://localhost:3000

# Email (SMTP). Development sends to Mailpit (UI at http://localhost:8025). Production points these at the chosen provider's SMTP.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="NITAP Alumni Network <no-reply@alumni.local>"
# Max emails per second the worker will send (provider rate limit).
EMAIL_RATE_PER_SECOND=5

# Worker process: internal health port (/health/live, /health/ready). Not exposed publicly.
WORKER_HEALTH_PORT=3001

# Institutional email policy: domain → { role, autoVerify }. Roles: STUDENT, ALUMNI, FACULTY, STAFF.
# autoVerify true → VERIFIED as soon as the address is confirmed; false → stays PENDING for admin confirmation.
# nitap.ac.in → STUDENT is a placeholder until the institute confirms its domains.
INSTITUTIONAL_EMAIL_POLICY='{"nitap.ac.in":{"role":"STUDENT","autoVerify":true},"staff.nitap.ac.in":{"role":"STAFF","autoVerify":false}}'

# Dev-only alumni coordinator (reviews verification requests), seeded by `pnpm db:seed`; E2E signs in as it.
# Never set these in a shared or production environment.
# DEV_COORDINATOR_EMAIL=coordinator@example.test
# DEV_COORDINATOR_PASSWORD=change-me-locally-1234
# One verified account per role, dev-<role>@example.test, all with this password (dev only).
# DEV_ROLES_PASSWORD=change-me-locally-1234

# First super admin of a real environment: `pnpm admin:bootstrap` (refuses if one exists). Set, run, then
# REMOVE these two variables. The password must be at least 12 characters and is never printed.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# Object storage. S3-compatible: MinIO in development, any S3-compatible
# provider in production — only these values change. If 9000 is taken:
# `MINIO_PORT=9002 pnpm docker:up`.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=alumini-uploads
S3_ACCESS_KEY_ID=alumini-storage
S3_SECRET_ACCESS_KEY=alumini-storage-secret
# path-style addressing (bucket.example.com vs example.com/bucket); MinIO needs it, most managed S3 providers don't.
S3_FORCE_PATH_STYLE=true
# Browser-facing storage path on the web app's origin, proxied to S3_ENDPOINT (apps/web app/storage route; only /storage), so the
# browser never talks to the store directly. Needs path-style. Unset = browser uses S3_ENDPOINT.
S3_PUBLIC_PATH=/storage

# Local observability stack (pnpm docker:observability): where alert runbook links point.
# RUNBOOK_BASE=https://github.com/OWNER/alumini/blob/main/ops/runbooks
