{
  "name": "nitap-alumni",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "admin:bootstrap": "pnpm --filter @nitap/web admin:bootstrap",
    "arch": "turbo run arch && pnpm arch:workspace",
    "arch:workspace": "depcruise packages --config .dependency-cruiser.cjs",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "db:deploy": "pnpm --filter @nitap/database db:deploy",
    "db:drift": "node --env-file-if-exists=.env packages/scripts/check-migration-drift.ts",
    "db:generate": "pnpm --filter @nitap/database db:generate",
    "db:migrate": "pnpm --filter @nitap/database db:migrate",
    "db:seed": "pnpm --filter @nitap/database db:seed && pnpm --filter @nitap/web db:seed:admin",
    "db:studio": "pnpm --filter @nitap/database db:studio",
    "dev": "turbo run dev",
    "docker:down": "docker compose --env-file .env -f docker/docker-compose.yml down",
    "docker:observability": "docker compose --env-file .env -f docker/docker-compose.yml -f docker/docker-compose.observability.yml up -d",
    "docker:observability:down": "docker compose --env-file .env -f docker/docker-compose.yml -f docker/docker-compose.observability.yml down",
    "docker:scan": "docker compose --env-file .env -f docker/docker-compose.yml --profile scan up -d clamav",
    "docker:up": "docker compose --env-file .env -f docker/docker-compose.yml up -d",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --include files,dependencies,unlisted,binaries,unresolved",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "ops:check": "node packages/scripts/check-ops.ts",
    "perf:run": "node --env-file-if-exists=.env packages/scripts/perf/run.ts",
    "perf:seed": "pnpm --filter @nitap/web perf:seed",
    "prepare": "lefthook install || true",
    "start": "turbo run start",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:ui": "turbo run test:e2e:ui",
    "test:integration": "turbo run test:integration",
    "test:watch": "turbo run test:watch --filter=@nitap/web",
    "typecheck": "turbo run typecheck",
    "worker:cli": "pnpm --filter @nitap/worker cli",
    "worker:dev": "turbo run dev --filter=@nitap/worker",
    "worker:prune": "turbo prune @nitap/worker --docker",
    "worker:prune:check": "node packages/scripts/verify-worker-prune.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/k6": "^2.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "dependency-cruiser": "18.3.1",
    "eslint-plugin-turbo": "^2.11.7",
    "knip": "^6.40.0",
    "lefthook": "^2.1.15",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.8",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.3"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  }
}
