// Prisma ORM 7. Models are added per docs/architecture/domain-model.md.
//
// user / session / account / verification are Better Auth's tables
// (docs/adr/ADR-005-authentication.md). They were generated with
//   npx auth@latest generate --config apps/web/src/lib/auth.ts --output database/prisma/schema.prisma
// (rate limiting is stored in Redis, so the generator's rate_limit table is intentionally not kept)
// and then adapted: snake_case columns via @map, timestamptz, and a real enum for account_state.
// Better Auth talks to them through the Prisma client, so @map is transparent to it. Re-run the
// generator on every Better Auth upgrade and diff the result against this file.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountState {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
  DEACTIVATED
}

model User {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String
  emailVerified Boolean      @default(false) @map("email_verified")
  image         String?
  // Set only by the server (verification workflow, admin actions); never client-settable.
  accountState  AccountState @default(PENDING) @map("account_state")
  deactivatedAt DateTime?    @map("deactivated_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  profile       Profile?

  userRoles              UserRole[]        @relation("UserRoleSubject")
  roleGrantsIssued       UserRole[]        @relation("UserRoleGrantor")
  permissionGrants       PermissionGrant[] @relation("PermissionGrantSubject")
  permissionGrantsIssued PermissionGrant[] @relation("PermissionGrantGrantor")

  // Case-insensitive uniqueness is a hand-written expression index, uq_user_email_ci
  // (migrations/20260920172049_case_insensitive_email) — not expressible in Prisma's schema language.
  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  // Password hash, credential provider only.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

enum DegreeLevel {
  UNDERGRADUATE
  POSTGRADUATE
  DOCTORAL
}

model Department {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String    @unique
  name      String
  shortName String    @map("short_name")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  profiles  Profile[]

  @@map("department")
}

model Degree {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String      @unique
  name      String
  level     DegreeLevel
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  profiles  Profile[]

  @@map("degree")
}

model Chapter {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String    @unique
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissionGrants PermissionGrant[]

  @@map("chapter")
}

model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("role")
}

model UserRole {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  user          User     @relation("UserRoleSubject", fields: [userId], references: [id], onDelete: Cascade)
  roleId        String   @map("role_id") @db.Uuid
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy     String   @map("granted_by") @db.Uuid
  grantedByUser User     @relation("UserRoleGrantor", fields: [grantedBy], references: [id], onDelete: Restrict)
  grantedAt     DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  @@unique([userId, roleId], map: "uq_user_role")
  @@map("user_role")
}

model RolePermission {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  // Validated against the code-side registry (database/prisma/seed-data/permissions.ts), not by
  // PostgreSQL — see the "Role / UserRole / RolePermission / PermissionGrant" note in domain-model.md.
  permission String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([roleId, permission], map: "uq_role_permission")
  @@map("role_permission")
}

enum PermissionScope {
  GLOBAL
  CHAPTER
}

model PermissionGrant {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  user          User            @relation("PermissionGrantSubject", fields: [userId], references: [id], onDelete: Cascade)
  permission    String
  scopeType     PermissionScope @map("scope_type")
  chapterId     String?         @map("chapter_id") @db.Uuid
  chapter       Chapter?        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  grantedBy     String          @map("granted_by") @db.Uuid
  grantedByUser User            @relation("PermissionGrantGrantor", fields: [grantedBy], references: [id], onDelete: Restrict)
  grantedAt     DateTime        @default(now()) @map("granted_at") @db.Timestamptz(3)
  expiresAt     DateTime?       @map("expires_at") @db.Timestamptz(3)

  // Declared here (unlike ck_grant_scope, a CHECK, which Prisma's schema-vs-db diff ignores
  // entirely) because Prisma's diff DOES compare plain multi-column unique indexes against
  // schema.prisma and will propose dropping one it can't find declared. The `NULLS NOT DISTINCT`
  // modifier itself still can't be expressed here — it lives only in this migration's hand-written
  // SQL (migrations/20260920172545_rbac) — but the name and columns must match to avoid drift.
  @@unique([userId, permission, scopeType, chapterId], map: "uq_permission_grant")
  @@map("permission_grant")
}

enum ProfileVisibility {
  PUBLIC
  MEMBERS_ONLY
  CONNECTIONS_ONLY
  PRIVATE
}

model Profile {
  userId    String   @id @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String   @map("full_name")
  headline  String?
  bio       String?
  // Nullable: faculty, staff and pending accounts may have no institutional record.
  // Alumni-completeness (FR-PROFILE-004) is an application rule, enforced in Phase 3 — not here.
  departmentId   String?           @map("department_id") @db.Uuid
  department     Department?       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  degreeId       String?           @map("degree_id") @db.Uuid
  degree         Degree?           @relation(fields: [degreeId], references: [id], onDelete: Restrict)
  // Static CHECK (2010-2100), never date-dependent — see ck_profile_graduation_year in this migration's SQL.
  graduationYear Int?              @map("graduation_year")
  location       String?
  photoUrl       String?           @map("photo_url")
  visibility     ProfileVisibility @default(MEMBERS_ONLY)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([departmentId, graduationYear])
  @@index([degreeId])
  @@index([graduationYear])
  @@map("profile")
}

/// Transactional outbox (ADR-007). Written in the same transaction as a state change; a relay in the
/// worker publishes unpublished rows to the queue. A row that can never be published is quarantined
/// (failed_at / failure_reason). The partial indexes and CHECK constraints live in the migration SQL.
model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          String
  payload       Json
  requestId     String?   @map("request_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  failedAt      DateTime? @map("failed_at") @db.Timestamptz(3)
  failureReason String?   @map("failure_reason")

  @@map("outbox_event")
}
