// Prisma ORM 7. Models are added per docs/architecture/domain-model.md.
//
// user / session / account / verification are Better Auth's tables
// (docs/adr/ADR-005-authentication.md). They were generated with
//   npx auth@latest generate --config apps/web/src/lib/auth.ts --output database/prisma/schema.prisma
// (rate limiting is stored in Redis, so the generator's rate_limit table is intentionally not kept)
// and then adapted: snake_case columns via @map, timestamptz, and a real enum for account_state.
// Better Auth talks to them through the Prisma client, so @map is transparent to it. Re-run the
// generator on every Better Auth upgrade and diff the result against this file.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountState {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
  DEACTIVATED
}

model User {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String
  emailVerified Boolean      @default(false) @map("email_verified")
  image         String?
  // Set only by the server (verification workflow, admin actions); never client-settable.
  accountState  AccountState @default(PENDING) @map("account_state")
  deactivatedAt DateTime?    @map("deactivated_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  profile       Profile?

  userRoles              UserRole[]        @relation("UserRoleSubject")
  roleGrantsIssued       UserRole[]        @relation("UserRoleGrantor")
  permissionGrants       PermissionGrant[] @relation("PermissionGrantSubject")
  permissionGrantsIssued PermissionGrant[] @relation("PermissionGrantGrantor")

  verificationRequests  VerificationRequest[] @relation("VerificationSubject")
  verificationsReviewed VerificationRequest[] @relation("VerificationReviewer")
  auditEntries          AuditLog[]            @relation("AuditActor")
  uploads               Upload[]

  idempotencyKeys      IdempotencyKey[]
  connectionsAsA       Connection[]        @relation("ConnectionUserA")
  connectionsAsB       Connection[]        @relation("ConnectionUserB")
  connectionsRequested Connection[]        @relation("ConnectionRequester")
  connectionsBlocked   Connection[]        @relation("ConnectionBlocker")
  mentorProfile        MentorProfile?
  mentorshipsAsMentor Mentorship[] @relation("MentorshipMentor")
  mentorshipsAsMentee Mentorship[] @relation("MentorshipMentee")
  jobsPosted   Job[] @relation("JobPoster")
  jobsReviewed Job[] @relation("JobReviewer")
  organizedEvents      Event[]             @relation("EventOrganizer")
  eventRegistrations   EventRegistration[]

  conversationsCreated Conversation[]            @relation("ConversationCreator")
  participations       ConversationParticipant[]
  messagesSent         Message[]
  reportsFiled         Report[]                  @relation("ReportReporter")
  reportsResolved      Report[]                  @relation("ReportResolver")

  posts                Post[]
  comments             Comment[]
  reactions            Reaction[]
  achievementsOwned    Achievement[] @relation("AchievementOwner")
  achievementsReviewed Achievement[] @relation("AchievementReviewer")

  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  // Case-insensitive uniqueness is a hand-written expression index, uq_user_email_ci
  // (migrations/20260920172049_case_insensitive_email) — not expressible in Prisma's schema language.
  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  // Password hash, credential provider only.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

enum DegreeLevel {
  UNDERGRADUATE
  POSTGRADUATE
  DOCTORAL
}

model Department {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String                @unique
  name                 String
  shortName            String                @map("short_name")
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  profiles             Profile[]
  verificationRequests VerificationRequest[]

  @@map("department")
}

model Degree {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String                @unique
  name                 String
  level                DegreeLevel
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  profiles             Profile[]
  verificationRequests VerificationRequest[]

  @@map("degree")
}

model Chapter {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String    @unique
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissionGrants PermissionGrant[]
  posts            Post[]

  @@map("chapter")
}

model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("role")
}

model UserRole {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  user          User     @relation("UserRoleSubject", fields: [userId], references: [id], onDelete: Cascade)
  roleId        String   @map("role_id") @db.Uuid
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy     String   @map("granted_by") @db.Uuid
  grantedByUser User     @relation("UserRoleGrantor", fields: [grantedBy], references: [id], onDelete: Restrict)
  grantedAt     DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  @@unique([userId, roleId], map: "uq_user_role")
  @@map("user_role")
}

model RolePermission {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  // Validated against the code-side registry (database/prisma/seed-data/permissions.ts), not by
  // PostgreSQL — see the "Role / UserRole / RolePermission / PermissionGrant" note in domain-model.md.
  permission String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([roleId, permission], map: "uq_role_permission")
  @@map("role_permission")
}

enum PermissionScope {
  GLOBAL
  CHAPTER
}

model PermissionGrant {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  user          User            @relation("PermissionGrantSubject", fields: [userId], references: [id], onDelete: Cascade)
  permission    String
  scopeType     PermissionScope @map("scope_type")
  chapterId     String?         @map("chapter_id") @db.Uuid
  chapter       Chapter?        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  grantedBy     String          @map("granted_by") @db.Uuid
  grantedByUser User            @relation("PermissionGrantGrantor", fields: [grantedBy], references: [id], onDelete: Restrict)
  grantedAt     DateTime        @default(now()) @map("granted_at") @db.Timestamptz(3)
  expiresAt     DateTime?       @map("expires_at") @db.Timestamptz(3)

  // Declared here (unlike ck_grant_scope, a CHECK, which Prisma's schema-vs-db diff ignores
  // entirely) because Prisma's diff DOES compare plain multi-column unique indexes against
  // schema.prisma and will propose dropping one it can't find declared. The `NULLS NOT DISTINCT`
  // modifier itself still can't be expressed here — it lives only in this migration's hand-written
  // SQL (migrations/20260920172545_rbac) — but the name and columns must match to avoid drift.
  @@unique([userId, permission, scopeType, chapterId], map: "uq_permission_grant")
  @@map("permission_grant")
}

enum ProfileVisibility {
  PUBLIC
  MEMBERS_ONLY
  CONNECTIONS_ONLY
  PRIVATE
}

model Profile {
  userId               String             @id @map("user_id") @db.Uuid
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName             String             @map("full_name")
  headline             String?
  bio                  String?
  // Nullable: faculty, staff and pending accounts may have no institutional record.
  // Alumni-completeness (FR-PROFILE-004) is an application rule, enforced in Phase 3 — not here.
  departmentId         String?            @map("department_id") @db.Uuid
  department           Department?        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  degreeId             String?            @map("degree_id") @db.Uuid
  degree               Degree?            @relation(fields: [degreeId], references: [id], onDelete: Restrict)
  // Static CHECK (2010-2100), never date-dependent — see ck_profile_graduation_year in this migration's SQL.
  graduationYear       Int?               @map("graduation_year")
  location             String?
  // The photo follows the core visibility level (spec 3C F-5): no fifth override column. Points at a
  // READY upload; ownership and purpose are checked by the use case, never assumed from this column alone.
  photoUploadId        String?            @unique @map("photo_upload_id") @db.Uuid
  photoUpload          Upload?            @relation(fields: [photoUploadId], references: [id], onDelete: SetNull)
  visibility           ProfileVisibility  @default(MEMBERS_ONLY)
  // Per-section overrides (spec 3A). NULL inherits `visibility`; never looser than it. The CHECKs are in
  // the profile_privacy migration's SQL (ck_profile_*_visibility); Postgres compares enums by declaration order.
  contactVisibility    ProfileVisibility? @map("contact_visibility")
  locationVisibility   ProfileVisibility? @map("location_visibility")
  experienceVisibility ProfileVisibility? @map("experience_visibility")
  educationVisibility  ProfileVisibility? @map("education_visibility")
  // UI-15: the role whose tick shows on the photo. NULL = automatic, a role name while held, 'NONE' = hidden.
  // Length CHECK (ck_profile_badge_role_length) is in the profile_badge_role migration's SQL.
  badgeRole            String?            @map("badge_role")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  experience ProfileExperience[]
  education  ProfileEducation[]
  skills     ProfileSkill[]
  links      ProfileLink[]

  @@index([departmentId, graduationYear])
  @@index([degreeId])
  @@index([graduationYear])
  @@map("profile")
}

enum ProfileLinkType {
  LINKEDIN
  GITHUB
  TWITTER
  WEBSITE
  OTHER
}

enum UploadPurpose {
  PROFILE_PHOTO
}

enum UploadStatus {
  PENDING_UPLOAD
  PENDING_SCAN
  READY
  REJECTED
}

/// A file the user owns, tracked from presign through scan (spec 3C). `objectKey` starts under
/// uploads/pending/ and, once READY, is rewritten to the scanned derivative's key (avatars/<userId>/...);
/// the CHECKs tying the prefix to status live in this migration's SQL.
model Upload {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String        @map("owner_id") @db.Uuid
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  purpose      UploadPurpose
  objectKey    String        @map("object_key")
  mime         String
  size         Int
  status       UploadStatus  @default(PENDING_UPLOAD)
  rejectReason String?       @map("reject_reason")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile Profile?

  @@index([ownerId, status])
  @@map("upload")
}

/// Work history (spec 3B). CHECKs (dates, is_current <=> no end date, lengths) are in the profile_details migration.
model ProfileExperience {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  profile     Profile   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  company     String
  industry    String?
  designation String
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  isCurrent   Boolean   @map("is_current")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, isCurrent, startDate(sort: Desc)])
  @@map("profile_experience")
}

/// Additional education (prior or later study). The institutional record stays on `profile` (FR-PROFILE-004).
model ProfileEducation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  profile       Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  institution   String
  qualification String
  fieldOfStudy  String?  @map("field_of_study")
  startYear     Int      @map("start_year")
  /// NULL = ongoing.
  endYear       Int?     @map("end_year")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, endYear(sort: Desc)])
  @@map("profile_education")
}

/// Free-text skill, unique per member on lower(skill) (uq_profile_skill_user_lower, in the migration SQL).
model ProfileSkill {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  profile   Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  skill     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("profile_skill")
}

model ProfileLink {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  profile   Profile         @relation(fields: [userId], references: [userId], onDelete: Cascade)
  type      ProfileLinkType
  url       String
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, url], map: "uq_profile_link_user_url")
  @@map("profile_link")
}

/// Transactional outbox (ADR-007). Written in the same transaction as a state change; a relay in the
/// worker publishes unpublished rows to the queue. A row that can never be published is quarantined
/// (failed_at / failure_reason). The partial indexes and CHECK constraints live in the migration SQL.
model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          String
  payload       Json
  requestId     String?   @map("request_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  failedAt      DateTime? @map("failed_at") @db.Timestamptz(3)
  failureReason String?   @map("failure_reason")

  @@map("outbox_event")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CrossCheckResult {
  NOT_CHECKED
  MATCH
  MISMATCH
}

/// Alumni verification evidence and its human decision (FR-AUTH-003/003a). There is no auto-approved
/// status by design. The partial unique index, CHECK constraints and the reviewer rule live in the
/// migration SQL (Prisma's schema language cannot express them): see migrations/*_verification_and_audit.
model VerificationRequest {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  user           User               @relation("VerificationSubject", fields: [userId], references: [id], onDelete: Cascade)
  rollNumber     String             @map("roll_number")
  departmentId   String             @map("department_id") @db.Uuid
  department     Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  degreeId       String             @map("degree_id") @db.Uuid
  degree         Degree             @relation(fields: [degreeId], references: [id], onDelete: Restrict)
  graduationYear Int                @map("graduation_year")
  supportingInfo String?            @map("supporting_info")
  status         VerificationStatus @default(PENDING)
  crossCheck     CrossCheckResult   @default(NOT_CHECKED) @map("cross_check")
  reviewedBy     String?            @map("reviewed_by") @db.Uuid
  reviewer       User?              @relation("VerificationReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)
  reviewedAt     DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  reviewNote     String?            @map("review_note")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, createdAt, id], map: "ix_verification_queue")
  @@index([userId, createdAt], map: "ix_verification_user_history")
  @@map("verification_request")
}

/// Append-only record of sensitive operations (SRS §22). A trigger in the migration rejects UPDATE,
/// DELETE and TRUNCATE. `target_id` is polymorphic (no foreign key). Metadata holds identifiers and
/// outcomes, never free text or an email address.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  actor      User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id") @db.Uuid
  metadata   Json     @default("{}")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([targetType, targetId, createdAt], map: "ix_audit_target")
  @@index([actorId, createdAt], map: "ix_audit_actor")
  @@index([action, createdAt], map: "ix_audit_action")
  @@map("audit_log")
}

enum ConnectionState {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

/// One row per unordered pair of users (FR-NET, domain-model §3). `user_a_id < user_b_id` is enforced,
/// so the unique pair catches A→B and B→A alike; who asked is `requested_by_id`. `NONE` is "no row".
/// A rejected pair re-requests by updating this row. The CHECKs (order, requester, blocker, responded_at)
/// live in the migration SQL: see migrations/*_connection.
model Connection {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAId       String          @map("user_a_id") @db.Uuid
  userA         User            @relation("ConnectionUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId       String          @map("user_b_id") @db.Uuid
  userB         User            @relation("ConnectionUserB", fields: [userBId], references: [id], onDelete: Cascade)
  requestedById String          @map("requested_by_id") @db.Uuid
  requestedBy   User            @relation("ConnectionRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  blockedById   String?         @map("blocked_by_id") @db.Uuid
  blockedBy     User?           @relation("ConnectionBlocker", fields: [blockedById], references: [id], onDelete: Cascade)
  state         ConnectionState @default(PENDING)
  requestedAt   DateTime        @default(now()) @map("requested_at") @db.Timestamptz(3)
  respondedAt   DateTime?       @map("responded_at") @db.Timestamptz(3)

  @@unique([userAId, userBId], map: "uq_connection_pair")
  @@index([userAId, state], map: "ix_connection_user_a")
  @@index([userBId, state], map: "ix_connection_user_b")
  @@map("connection")
}

enum MentorContactMethod {
  IN_APP
  EMAIL
  VIDEO_CALL
  PHONE
}

/// FR-MENTOR-001/002. One opt-in row per user; "active mentor" is defined by the application (spec M-2).
/// Length/range CHECKs live in the migration SQL (ck_mentor_*).
model MentorProfile {
  userId                 String              @id @map("user_id") @db.Uuid
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  expertise              String
  topics                 String[]            @default([])
  availability           String              @default("")
  preferredContactMethod MentorContactMethod @default(IN_APP) @map("preferred_contact_method")
  maxMentees             Int                 @default(3) @map("max_mentees")
  accepting              Boolean             @default(true)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([topics], type: Gin, map: "ix_mentor_profile_topics")
  @@index([accepting], map: "ix_mentor_profile_accepting")
  @@map("mentor_profile")
}

enum MentorshipState {
  REQUESTED
  ACCEPTED
  ACTIVE
  COMPLETED
  DECLINED
  CANCELLED
}

/// FR-MENTOR-004…006. History is kept: a terminal row is never reused (spec M-4). The open-pair index
/// `uq_mentorship_open_pair` is PARTIAL (WHERE state IN open states) and is written by hand in the migration.
model Mentorship {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mentorId     String          @map("mentor_id") @db.Uuid
  mentor       User            @relation("MentorshipMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  menteeId     String          @map("mentee_id") @db.Uuid
  mentee       User            @relation("MentorshipMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  state        MentorshipState @default(REQUESTED)
  topic        String?
  message      String
  responseNote String?         @map("response_note")
  requestedAt  DateTime        @default(now()) @map("requested_at") @db.Timestamptz(3)
  respondedAt  DateTime?       @map("responded_at") @db.Timestamptz(3)
  startedAt    DateTime?       @map("started_at") @db.Timestamptz(3)
  endedAt      DateTime?       @map("ended_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([mentorId, menteeId], map: "uq_mentorship_open_pair")
  @@index([mentorId, state], map: "ix_mentorship_mentor")
  @@index([menteeId, state], map: "ix_mentorship_mentee")
  @@map("mentorship")
}

enum JobStatus {
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  EXPIRED
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

/// FR-JOB-001…005. No DRAFT state (D7, spec J-2): create is submit. REJECTED is NOT terminal (spec J-3):
/// editing a REJECTED job resubmits it to PENDING_REVIEW. EXPIRED and CLOSED are the only terminal states,
/// and EXPIRED is set only by the `job.expire` worker sweep (spec J-7).
model Job {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postedBy       String         @map("posted_by") @db.Uuid
  poster         User           @relation("JobPoster", fields: [postedBy], references: [id], onDelete: Cascade)
  title          String
  company        String
  description    String
  employmentType EmploymentType @map("employment_type")
  location       String
  workMode       WorkMode       @map("work_mode")
  experience     String
  skills         String[]       @default([])
  applicationUrl String         @map("application_url")
  deadline       DateTime       @db.Date
  status         JobStatus      @default(PENDING_REVIEW)
  reviewedBy     String?        @map("reviewed_by") @db.Uuid
  reviewer       User?          @relation("JobReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  reviewNote     String?        @map("review_note")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, deadline], map: "ix_job_status_deadline")
  @@index([postedBy, createdAt], map: "ix_job_poster")
  @@index([status, createdAt], map: "ix_job_moderation_queue")
  @@map("job")
}

enum IdempotencyState {
  IN_PROGRESS
  DONE
}

/// `Idempotency-Key` bookkeeping (API spec §1.6): scoped per user, 24 h retention (swept daily). A claim
/// commits on its own, outside the business transaction. The DONE/response pairing CHECK lives in the
/// migration SQL: see migrations/*_idempotency_key.
model IdempotencyKey {
  userId      String           @map("user_id") @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String           @map("idem_key")
  requestHash String           @map("request_hash")
  state       IdempotencyState @default(IN_PROGRESS)
  /// `{ status, body, headers }` of the stored response; set exactly when state is DONE.
  response    Json?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, key], map: "pk_idempotency_key")
  @@index([createdAt], map: "ix_idempotency_created")
  @@map("idempotency_key")
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  POST
  USER
  MESSAGE
  COMMENT
}

/// FR-MSG. A 1:1 conversation carries `direct_pair_key` (`min:max` of the two lower-case user ids) so a pair
/// has exactly one; a group carries none. `last_message_*` are denormalised for the inbox order and are
/// written only in the send transaction, which holds this row's lock. CHECKs live in the migration SQL.
model Conversation {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdById    String                    @map("created_by_id") @db.Uuid
  createdBy      User                      @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  isGroup        Boolean                   @map("is_group")
  title          String?
  directPairKey  String?                   @unique(map: "uq_conversation_direct_pair") @map("direct_pair_key")
  lastMessageSeq BigInt                    @default(0) @map("last_message_seq")
  lastMessageAt  DateTime?                 @map("last_message_at") @db.Timestamptz(3)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  participants   ConversationParticipant[]
  messages       Message[]

  @@map("conversation")
}

/// Membership plus per-member read state. `last_read_seq` is the read marker; `unread_count` is the
/// denormalised counter, rebuildable from `message` and `last_read_seq`.
model ConversationParticipant {
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamptz(3)
  lastReadSeq    BigInt       @default(0) @map("last_read_seq")
  unreadCount    Int          @default(0) @map("unread_count")

  @@id([conversationId, userId], map: "pk_conversation_participant")
  @@index([userId], map: "ix_conversation_participant_user")
  @@map("conversation_participant")
}

/// `seq` is the ordering key (BIGSERIAL): message ids are random UUIDs. `client_message_id` makes a retried
/// send idempotent per (conversation, sender).
model Message {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seq             BigInt       @unique(map: "uq_message_seq") @default(autoincrement())
  conversationId  String       @map("conversation_id") @db.Uuid
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String       @map("sender_id") @db.Uuid
  sender          User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body            String
  clientMessageId String       @map("client_message_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set when a moderator resolves a report on this message (12C C12-4). One-way; reads return a tombstone.
  hiddenAt        DateTime?    @map("hidden_at") @db.Timestamptz(3)

  @@unique([conversationId, senderId, clientMessageId], map: "uq_message_client_id")
  @@index([conversationId, seq(sort: Desc)], map: "ix_message_conversation_seq")
  @@map("message")
}

/// FR-MSG-004 (D6). Polymorphic target: `target_id` has no foreign key, validity is checked by the
/// application. Phase 9 files reports for MESSAGE targets; moderation arrives in Phases 10 and 12.
model Report {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId   String           @map("reporter_id") @db.Uuid
  reporter     User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   ReportTargetType @map("target_type")
  targetId     String           @map("target_id") @db.Uuid
  reason       String
  status       ReportStatus     @default(OPEN)
  resolvedById String?          @map("resolved_by_id") @db.Uuid
  resolvedBy   User?            @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([reporterId, targetType, targetId], map: "uq_report_once")
  @@index([status, createdAt], map: "ix_report_status")
  @@map("report")
}

enum PostType {
  TEXT
  ACHIEVEMENT
}

enum AchievementCategory {
  AWARD
  PUBLICATION
  PROMOTION
  CERTIFICATION
  ENTREPRENEURSHIP
  OTHER
}

enum AchievementStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  WITHDRAWN
}

/// FR-FEED. `content` is raw Markdown, rendered only through the sanitized pipeline (modules/posts,
/// presentation/ui/markdown-view.tsx) — no images/headings/raw HTML in the render allow-list even though
/// the source string itself isn't bounded to that subset. `chapter_id` exists for a later phase's scoping
/// (C-5): every Phase 10 post has it null; no filter reads it yet. `post_type = ACHIEVEMENT` is set only by
/// achievements' publish transaction (C-12), never by createPost directly — enforced at the application layer.
model Post {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId    String       @map("author_id") @db.Uuid
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  chapterId   String?      @map("chapter_id") @db.Uuid
  chapter     Chapter?     @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  content     String
  imageUrls   String[]     @map("image_urls")
  linkUrl     String?      @map("link_url")
  postType    PostType     @default(TEXT) @map("post_type")
  deleted     Boolean      @default(false)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  comments    Comment[]
  reactions   Reaction[]
  achievement Achievement?

  @@index([createdAt(sort: Desc), id], map: "ix_post_feed")
  @@map("post")
}

/// FR-FEED-003. Soft-delete mirrors Post's (`deleted`), not a separate tombstone table (C-9).
model Comment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id") @db.Uuid
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([postId, createdAt], map: "ix_comment_post")
  @@map("comment")
}

/// `type` is a free string validated against a fixed allow-list at the application layer (domain model's
/// note under Post/Comment/Reaction: extending the set later needs no migration). One row per (post, user);
/// reacting again replaces it rather than adding a second (application layer does an upsert on this key).
model Reaction {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([postId, userId], map: "uq_reaction_per_user")
  @@map("reaction")
}

/// FR-ACH. State machine in modules/achievements/domain/achievement.ts mirrors mentorship.ts's shape.
/// `published_post_id` is set only in the same transaction as the APPROVED → PUBLISHED transition (C-12);
/// ck_achievement_published ties the two together. `reviewed_by_id` is set on entering UNDER_REVIEW or later.
model Achievement {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  user            User                @relation("AchievementOwner", fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String
  category        AchievementCategory
  status          AchievementStatus   @default(SUBMITTED)
  reviewedById    String?             @map("reviewed_by_id") @db.Uuid
  reviewedBy      User?               @relation("AchievementReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  publishedPostId String?             @unique(map: "uq_achievement_published_post") @map("published_post_id") @db.Uuid
  publishedPost   Post?               @relation(fields: [publishedPostId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt], map: "ix_achievement_status")
  @@map("achievement")
}

enum EventStatus {
  SCHEDULED
  CANCELLED
}

enum EventRegistrationState {
  REGISTERED
  CANCELLED
  ATTENDED
  NO_SHOW
}

/// FR-EVENT-001/002. `registered_count` is the guarded capacity counter (spec E-5): it only moves through
/// `UPDATE … WHERE registered_count < capacity`, and `ck_event_registered_count` is the backstop. The CHECKs
/// live in the migration SQL: see migrations/*_events.
model Event {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizerId          String              @map("organizer_id") @db.Uuid
  organizer            User                @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  title                String
  description          String
  startsAt             DateTime            @map("starts_at") @db.Timestamptz(3)
  /// IANA zone the event is displayed in; `starts_at` is the instant.
  timezone             String
  location             String?
  isOnline             Boolean             @map("is_online")
  capacity             Int
  registeredCount      Int                 @default(0) @map("registered_count")
  registrationDeadline DateTime            @map("registration_deadline") @db.Timestamptz(3)
  status               EventStatus         @default(SCHEDULED)
  cancelledAt          DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  registrations        EventRegistration[]

  @@index([status, startsAt, id], map: "ix_event_upcoming")
  @@index([organizerId, startsAt], map: "ix_event_organizer")
  @@map("event")
}

/// FR-EVENT-003/005. One row per (user, event) forever: re-registering after a cancel reuses it (spec E-4).
model EventRegistration {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String                 @map("event_id") @db.Uuid
  event        Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String                 @map("user_id") @db.Uuid
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  state        EventRegistrationState @default(REGISTERED)
  registeredAt DateTime               @default(now()) @map("registered_at") @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, eventId], map: "uq_event_registration")
  @@index([eventId, state], map: "ix_event_registration_event")
  @@map("event_registration")
}

// NOTIFICATION

enum NotificationCategory {
  TRANSACTIONAL
  ENGAGEMENT
}

/** The granular grouping the preferences UI toggles (N-14) — distinct from NotificationCategory, which
 * only says whether preferences apply at all. Every event in the catalogue maps to exactly one domain
 * via domainFor() in the notifications domain layer (Task 3). */
enum NotificationDomain {
  CONNECTION
  MENTORSHIP
  JOB
  EVENT
  MESSAGE
  POST
  ACHIEVEMENT
  MODERATION
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String                 @map("recipient_id") @db.Uuid
  recipient   User                   @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        String
  category    NotificationCategory
  payload     Json
  dedupeKey   String                 @unique(map: "uq_notification_dedupe_key") @map("dedupe_key")
  readAt      DateTime?              @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  deliveries  NotificationDelivery[]

  @@index([recipientId, createdAt(sort: Desc)], map: "ix_notification_recipient_created")
  @@index([recipientId, readAt], map: "ix_notification_recipient_unread")
  @@map("notification")
}

model NotificationPreference {
  userId    String              @map("user_id") @db.Uuid
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain    NotificationDomain
  channel   NotificationChannel
  enabled   Boolean
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([userId, domain, channel])
  @@map("notification_preference")
}

model NotificationDelivery {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId    String              @map("notification_id") @db.Uuid
  notification      Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel           NotificationChannel
  status            DeliveryStatus      @default(PENDING)
  attempts          Int                 @default(0)
  lastError         String?             @map("last_error")
  providerMessageId String?             @map("provider_message_id")
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([notificationId, channel], map: "ux_notification_delivery_notification_channel")
  @@index([status], map: "ix_notification_delivery_status")
  @@map("notification_delivery")
}

model EmailSuppression {
  emailHash String   @id @map("email_hash")
  reason    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("email_suppression")
}
