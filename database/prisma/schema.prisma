// Prisma ORM 7. Models are added per docs/architecture/domain-model.md.
//
// user / session / account / verification are Better Auth's tables
// (docs/adr/ADR-005-authentication.md). They were generated with
//   npx auth@latest generate --config apps/web/src/lib/auth.ts --output database/prisma/schema.prisma
// (rate limiting is stored in Redis, so the generator's rate_limit table is intentionally not kept)
// and then adapted: snake_case columns via @map, timestamptz, and a real enum for account_state.
// Better Auth talks to them through the Prisma client, so @map is transparent to it. Re-run the
// generator on every Better Auth upgrade and diff the result against this file.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountState {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
  DEACTIVATED
}

model User {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String
  emailVerified Boolean      @default(false) @map("email_verified")
  image         String?
  // Set only by the server (verification workflow, admin actions); never client-settable.
  accountState  AccountState @default(PENDING) @map("account_state")
  deactivatedAt DateTime?    @map("deactivated_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  profile       Profile?

  // Case-insensitive uniqueness is a hand-written expression index, uq_user_email_ci
  // (migrations/20260920172049_case_insensitive_email) — not expressible in Prisma's schema language.
  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  // Password hash, credential provider only.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

enum DegreeLevel {
  UNDERGRADUATE
  POSTGRADUATE
  DOCTORAL
}

model Department {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String    @unique
  name      String
  shortName String    @map("short_name")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  profiles  Profile[]

  @@map("department")
}

model Degree {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String      @unique
  name      String
  level     DegreeLevel
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  profiles  Profile[]

  @@map("degree")
}

model Chapter {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String    @unique
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("chapter")
}

enum ProfileVisibility {
  PUBLIC
  MEMBERS_ONLY
  CONNECTIONS_ONLY
  PRIVATE
}

model Profile {
  userId    String   @id @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String   @map("full_name")
  headline  String?
  bio       String?
  // Nullable: faculty, staff and pending accounts may have no institutional record.
  // Alumni-completeness (FR-PROFILE-004) is an application rule, enforced in Phase 3 — not here.
  departmentId   String?           @map("department_id") @db.Uuid
  department     Department?       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  degreeId       String?           @map("degree_id") @db.Uuid
  degree         Degree?           @relation(fields: [degreeId], references: [id], onDelete: Restrict)
  // Static CHECK (2010-2100), never date-dependent — see ck_profile_graduation_year in this migration's SQL.
  graduationYear Int?              @map("graduation_year")
  location       String?
  photoUrl       String?           @map("photo_url")
  visibility     ProfileVisibility @default(MEMBERS_ONLY)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([departmentId, graduationYear])
  @@index([degreeId])
  @@index([graduationYear])
  @@map("profile")
}
