{
  "name": "@nitap/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./outbox": "./outbox/index.ts",
    "./permissions": "./prisma/seed-data/permissions.ts",
    "./role-permissions": "./prisma/seed-data/role-permissions.ts",
    "./seed": "./prisma/seed.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "test": "pnpm --filter @nitap/web exec vitest run --project unit prisma/seed-data",
    "test:watch": "pnpm --filter @nitap/web exec vitest --project unit prisma/seed-data"
  },
  "dependencies": {
    "@nitap/jobs": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "dotenv": "^18.0.1",
    "prisma": "7.10.0"
  }
}
