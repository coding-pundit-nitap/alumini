{
  "name": "@nitap/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./outbox": "./outbox/index.ts",
    "./audit": "./audit/index.ts",
    "./uploads": "./uploads/index.ts",
    "./jobs": "./jobs/index.ts",
    "./donations": "./donations/index.ts",
    "./idempotency": "./idempotency/index.ts",
    "./notifications": "./notifications/index.ts",
    "./permissions": "./prisma/seed-data/permissions.ts",
    "./enums": "./generated/prisma/enums.ts",
    "./role-permissions": "./prisma/seed-data/role-permissions.ts",
    "./role-ticks": "./prisma/seed-data/role-ticks.ts",
    "./retention": "./prisma/seed-data/retention.ts",
    "./seed": "./prisma/seed.ts",
    "./runtime-role": "./prisma/runtime-role.ts",
    "./perf": "./perf/index.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:release": "prisma migrate deploy && node prisma/seed.ts && node prisma/runtime-role.ts",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:seed": "node --env-file-if-exists=../../.env prisma/seed.ts",
    "test": "pnpm --filter @nitap/web exec vitest run --project unit prisma/seed-data perf",
    "test:watch": "pnpm --filter @nitap/web exec vitest --project unit prisma/seed-data perf"
  },
  "dependencies": {
    "@nitap/jobs": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "dotenv": "^18.0.1",
    "prisma": "7.10.0",
    "vitest": "^5.0.1"
  }
}
