# Secrets for deploy/monitoring.yml only. Copy to deploy/monitoring.env (gitignored), chmod 600.
# Kept apart from deploy/.env, which every application container receives as its environment. The stack also
# reads deploy/.env for DEPLOY_ENV, APP_URL, HEALTH_CHECK_TOKEN and POSTGRES_PASSWORD.

# openssl rand -hex 24. postgres-exporter's role (`monitoring`, pg_monitor); created and updated on every `up`.
MONITORING_DB_PASSWORD=
# Grafana's `admin` user. Grafana is published on 127.0.0.1 only (README: Monitoring).
GRAFANA_ADMIN_PASSWORD=

# Alertmanager webhook receivers (ops/alertmanager/alertmanager.yml). Pages wake someone; tickets wait for
# working hours. The dead-man's switch MUST be outside this host: a service that pages when
# the Watchdog heartbeat, sent every minute, stops for 3 minutes.
ALERT_PAGER_URL=
ALERT_TICKET_URL=
ALERT_DEADMANS_SWITCH_URL=

# Published on 127.0.0.1 only; change if they clash with something else on the host.
# PROMETHEUS_PORT=9090
# ALERTMANAGER_PORT=9093
# GRAFANA_PORT=3030
# The public probe's target; defaults to APP_URL/health/ready.
# PROBE_URL=
# Where deploy/backup.sh writes its metrics for node_exporter (README step 8).
# BACKUP_METRICS_DIR=/var/lib/prometheus/node-exporter
