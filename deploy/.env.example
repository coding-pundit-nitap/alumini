# Environment for deploy/compose.yml, production or staging. Copy to deploy/.env on the server (gitignored),
# chmod 600. Never commit the filled-in copy. Database, Redis, storage and clamd addresses are set by compose.yml.

# production or staging (spec 18 PRD-1). Staging releases CI's images with `deploy.sh pull`; production
# releases only what passed staging, with `deploy.sh promote <sha> <approver>`.
DEPLOY_ENV=production
# Staging only: a project name of its own, and another port if it shares a host with production.
# COMPOSE_PROJECT_NAME=alumini-staging
# WEB_PORT=3001
# Where web listens: 127.0.0.1:3000 by default, for the host's Nginx. Behind a proxy on another machine
# (Nginx Proxy Manager): WEB_BIND=0.0.0.0 and WEB_PORT=80, with the port firewalled to that proxy.
# WEB_BIND=127.0.0.1

# Where CI publishes images (pull and promote): ghcr.io/<lowercase GitHub owner>
IMAGE_REGISTRY=ghcr.io/OWNER
# Production only: staging's releases.log, as a local path or user@host:/path read over ssh.
# STAGING_RELEASES=deploy@staging.example.org:/opt/alumini/deploy/releases.log
# Written by deploy.sh on every release; do not edit by hand.
RELEASE_SHA=
WEB_IMAGE=
WORKER_IMAGE=
MIGRATE_IMAGE=
POSTGRES_IMAGE=

# Infrastructure secrets. Hex only (openssl rand -hex 24): they end up inside URLs.
POSTGRES_PASSWORD=
# The runtime role web and worker connect as (no DDL); the migrate job sets it on every release.
APP_DB_PASSWORD=
MINIO_ROOT_USER=alumini-storage
MINIO_ROOT_PASSWORD=

# Off-host backup repository (ADR-011, deploy/README.md step 8): an S3-compatible bucket with a different
# provider or account from this server, versioning on, noncurrent versions kept 30 days, and a key that can
# write and delete objects but not purge versions. Endpoint is the bare host name (https is required).
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_KEY_SECRET=
# host (bucket.endpoint) or path (endpoint/bucket); some providers only support one.
BACKUP_S3_URI_STYLE=host
# openssl rand -base64 48. Encrypts every backup. ESCROW IT apart from the bucket, readable by two people:
# without it no backup can be restored (reliability §3.5).
BACKUP_CIPHER_PASS=

# The public origin, https and no trailing slash. All three are the same value.
NEXT_PUBLIC_APP_URL=https://alumni.example.org
BETTER_AUTH_URL=https://alumni.example.org
APP_URL=https://alumni.example.org

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -hex 24. Gates /metrics and the /health/ready detail, and authorises /health/drain.
HEALTH_CHECK_TOKEN=

# Real SMTP provider: smtp://user:pass@host:587 (or smtps://...:465)
SMTP_URL=
EMAIL_FROM="NITAP Alumni Network <no-reply@alumni.example.org>"
EMAIL_RATE_PER_SECOND=5

# Recognised institutional domains (ADR-019). Confirm the real list with the institute before launch.
INSTITUTIONAL_EMAIL_POLICY='{"nitap.ac.in":{"role":"STUDENT","autoVerify":true}}'

# Smoke test after every release (deploy.sh smoke): a verified member account kept for it, password hex only
# (openssl rand -hex 24). Required on staging, where a release without a passing smoke test cannot be promoted.
SMOKE_EMAIL=
SMOKE_PASSWORD=
# Defaults to APP_URL, so the test goes through Nginx and TLS.
# SMOKE_URL=

LOG_LEVEL=info
# web's Node options; compose.yml caps the heap at 1 GB (--max-old-space-size=1024) when unset.
# WEB_NODE_OPTIONS=--max-old-space-size=1536
# Error tracker (Sentry or GlitchTip). Unset = off.
# SENTRY_DSN=

# First super admin only: set, run the bootstrap once, then DELETE both lines.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
